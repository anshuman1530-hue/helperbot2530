@app.route("/", methods=["GET", "POST"])
def home():
    if request.method == "POST":
        text = request.form["message"].strip()
        if text:
            handle(text)
        return redirect("/#end")  # stops a refresh resending; #end scrolls to the newest message
    return render_template_string(PAGE, chat=get_visitor()["chat"])


@app.route("/voice", methods=["POST"])
def voice():
    text = (request.json or {}).get("message", "").strip()
    if not text:
        return jsonify({"reply": "I didn't catch that."})
    return jsonify({"reply": handle(text)})


