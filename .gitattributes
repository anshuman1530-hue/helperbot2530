# --- The "brain": find the most similar example sentence --------------------
#   words()      splits text into lowercase words
#   fix_typos()  swaps a misspelled word for the closest word the bot knows
#   weight()     rare words count more than common ones (the idea behind TF-IDF)
#   cosine()     scores how similar two messages are, from 0 (nothing) to 1 (same)

FILLER = {"please", "pls", "plz", "bro", "dude", "buddy", "mate", "just", "kindly", "today", "now"}


def words(text):
    found = re.findall(r"[a-z0-9]+", text.lower().replace("'", ""))
    found = [w for w in found if w not in FILLER]
    # strip a plural "s" so jokes = joke and thanks = thank
    return [w[:-1] if len(w) > 3 and w.endswith("s") else w for w in found]


EXAMPLES = [(name, words(ex)) for name, intent in INTENTS.items()
            for ex in intent["examples"]]
DOC_FREQ = Counter(w for _, ws in EXAMPLES for w in set(ws))  # in how many examples
VOCAB = list(DOC_FREQ)


def weight(word):
    return math.log((len(EXAMPLES) + 1) / (DOC_FREQ.get(word, 0) + 1)) + 1


def vector(ws):
    # a word the bot has never seen counts extra, so a new topic is not matched by accident
    return {w: count * weight(w) * (1 if w in DOC_FREQ else UNKNOWN_PENALTY)
            for w, count in Counter(ws).items()}


def cosine(a, b):
    dot = sum(a[w] * b[w] for w in a if w in b)
    size_a = math.sqrt(sum(x * x for x in a.values()))
    size_b = math.sqrt(sum(x * x for x in b.values()))
    return dot / (size_a * size_b) if size_a and size_b else 0.0


def fix_typos(ws):
    fixed = []
    for w in ws:
        if w in DOC_FREQ:
            fixed.append(w)
        else:
            close = difflib.get_close_matches(w, VOCAB, n=1, cutoff=0.8)
            fixed.append(close[0] if close else w)
    return fixed


UNKNOWN_PENALTY = 1.5
EXAMPLE_VECTORS = [(name, vector(ws)) for name, ws in EXAMPLES]
MIN_SCORE = 0.6   # below this similarity the bot admits it doesn't know


def best_intent(text):
    """Return (intent name, similarity score) for the closest known example."""
    ws = fix_typos(words(text))
    if not ws:
        return None, 0.0
    v = vector(ws)
    best, score = None, 0.0
    for name, example in EXAMPLE_VECTORS:
        s = cosine(v, example)
        if s > score:
            best, score = name, s
    return best, score


def get_reply(msg, history):
    # rules that need the visitor's own data come first
    if msg.startswith("my name is "):
        session["name"] = msg[11:].strip().title()[:30]
        return f"Nice to meet you, {session['name']}!"
    if "who am i" in msg or "my name" in msg:
        name = session.get("name")
        if name:
            return f"You're {name}!"
        return "I don't know yet. Say 'my name is ...'"
    if msg in ("bye", "goodbye", "quit"):
        return "Goodbye!"
    if "last" in words(msg) and len(history) > 1:
        return f'Earlier you said: "{history[-2]}"'

    # everything else: find the closest known intent
    name, score = best_intent(msg)
    if name and score >= MIN_SCORE:
        reply = INTENTS[name]["reply"]
        return reply() if callable(reply) else random.choice(reply)

    return None   # no intent matched; handle() decides what happens next


def ask_ai(v, text):
    """Ask an AI model through OpenRouter. Returns None when it isn't set up."""
    if not OPENROUTER_KEY or requests is None:
        return None

    today = date.today()
    if usage["day"] != today:
        usage["day"], usage["count"] = today, 0
    if usage["count"] >= DAILY_LIMIT or v["ai_calls"] >= PER_VISITOR_LIMIT:
        return "I've used up my AI answers for now. Try again later!"
    usage["count"] += 1      # failed tries count against OpenRouter's daily limit too
    v["ai_calls"] += 1

    # the last few chat turns give the AI some memory of the conversation
    turns = []
    for who, t in v["chat"][-10:]:
        turns.append({"role": "user" if who == "You" else "assistant", "content": t})
    while turns and turns[0]["role"] != "user":
        turns.pop(0)
    messages = [{"role": "system", "content": SYSTEM_PROMPT}] + turns
    messages.append({"role": "user", "content": text})

    try:
        r = requests.post(
            "https://openrouter.ai/api/v1/chat/completions",
            headers={"Authorization": "Bearer " + OPENROUTER_KEY},
            json={"models": AI_MODELS, "messages": messages, "max_tokens": 800},
            timeout=40,
        )
        if r.status_code != 200:
            app.logger.warning("OpenRouter error %s: %s", r.status_code, r.text[:300])
            if r.status_code == 429:
                return "My AI brain is busy right now. Try again in a minute!"
            return "Sorry, my AI brain isn't reachable right now."
        answer = (r.json()["choices"][0]["message"]["content"] or "").strip()
        return answer or "Sorry, I couldn't think of an answer to that."
    except Exception as e:
        app.logger.warning("OpenRouter request failed: %s", e)
        return "Sorry, my AI brain isn't reachable right now."


def handle(text):
    """Run one message through the bot and record both sides of this visitor's chat."""
    v = get_visitor()
    text = text[:500]
    msg = text.lower()
    v["history"].append(msg)
    reply = get_reply(msg, v["history"])
    if reply is None:
        reply = ask_ai(v, text) or FALLBACK
    v["chat"] += [("You", text), ("HelperBot", reply)]
    del v["chat"][:-60]       # keep only the latest 60 messages
    del v["history"][:-60]
    return reply


