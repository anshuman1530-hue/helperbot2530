def get_visitor():
    """Give each browser its own id (kept in a signed cookie) and its own chat."""
    vid = session.get("id")
    if vid is None:
        vid = session["id"] = uuid.uuid4().hex
        session.permanent = True
    if vid not in visitors:
        if len(visitors) > 500:                   # keep server memory small
            visitors.pop(next(iter(visitors)))    # drop the oldest visitor
        name = session.get("name")
        if name:
            greeting = f"Welcome back, {name}!"
        else:
            greeting = "Hi! Try 'tell me a joke' or 'flip a coin'."
        visitors[vid] = {"chat": [("HelperBot", greeting)], "history": [], "ai_calls": 0}
    return visitors[vid]


